# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/typeflow

# JWT
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_RESET_SECRET=replace-with-long-random-secret

# Server
PORT=3001

# n8n outbound webhooks (backend -> n8n)
N8N_WEBHOOK_USER_SIGNUP_URL=http://localhost:5678/webhook/typeflow/user-signup
N8N_WEBHOOK_TEST_COMPLETE_URL=http://localhost:5678/webhook/typeflow/test-complete
N8N_WEBHOOK_SECRET=replace-with-shared-webhook-secret
N8N_REQUEST_TIMEOUT_MS=6000

# n8n inbound auth (n8n -> backend)
N8N_INTERNAL_SECRET=replace-with-internal-secret

# n8n instance/runtime variables (used in workflow expressions)
BACKEND_BASE_URL=http://localhost:3001
REPORT_USER_ID=replace-with-a-real-mongodb-user-id
REPORT_TO_EMAIL=reports@example.com
SMTP_FROM_EMAIL=no-reply@typeflow.app
ADMIN_EMAIL=admin@typeflow.app
